// 愈见 - Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  clerkId       String    @unique
  email         String    @unique
  name          String
  preferences   Json      @default("{\"aiTemperature\": 0.75}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memories      Memory[]
  moodEntries   MoodEntry[]
  conversations Conversation[]
  tasks         Task[]

  @@map("users")
}

model Memory {
  id              String       @id @default(cuid())
  userId          String
  key             String
  value           String
  category        MemoryCategory
  importance      Int          @default(3)
  sourceEntryId   String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  lastAccessedAt  DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastAccessedAt])
  @@map("memories")
}

enum MemoryCategory {
  event
  fact
  preference
  emotion
}

model MoodEntry {
  id                    String   @id @default(cuid())
  userId                String
  date                  DateTime @db.Date
  score                 Int
  note                  String   @db.Text
  conversationSummary   String   @db.Text
  keyTopics             String[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation  Conversation?
  task          Task?

  @@unique([userId, date])
  @@index([userId, date])
  @@map("mood_entries")
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  entryId   String   @unique
  messages  Json
  startedAt DateTime @default(now())
  endedAt   DateTime?
  status    ConversationStatus @default(active)

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry MoodEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@map("conversations")
}

enum ConversationStatus {
  active
  completed
  abandoned
}

model Task {
  id              String     @id @default(cuid())
  userId          String
  entryId         String     @unique
  title           String
  description     String
  type            TaskType
  estimatedTime   String
  status          TaskStatus @default(pending)
  feedback        String?    @db.Text
  completedAt     DateTime?
  createdAt       DateTime   @default(now())

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry MoodEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

enum TaskType {
  breathing
  walking
  writing
  observing
  other
}

enum TaskStatus {
  pending
  accepted
  completed
  skipped
}
